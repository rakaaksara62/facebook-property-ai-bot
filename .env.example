# ==============================================================================
# TEMPLATE KONFIGURASI BOT SCRAPER PROPERTI FACEBOOK (.ENV.EXAMPLE)
# ==============================================================================
# Salin file ini menjadi '.env' lalu isi kredensial Anda di bawah ini:
#
#    Windows PowerShell : Copy-Item .env.example .env
#    Linux / macOS      : cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GROQ API KEY (Wajib - Digunakan untuk Filter AI Tingkat 2)
# Dapatkan gratis di: https://console.groq.com/keys
# Model default: openai/gpt-oss-120b
# ------------------------------------------------------------------------------
GROQ_API_KEY="gsk_masukkan_groq_api_key_kamu_di_sini"
GROQ_MODEL="openai/gpt-oss-120b"

# ------------------------------------------------------------------------------
# 2. GOOGLE GEMINI API KEYS (Opsional - Fallback jika Groq down)
# Dapatkan di: https://aistudio.google.com/app/apikey
# Anda bisa memasukkan 1 key atau multiple keys dipisahkan koma
# ------------------------------------------------------------------------------
GEMINI_API_KEYS="masukkan_gemini_api_key_opsional_di_sini"

# ------------------------------------------------------------------------------
# 3. TELEGRAM BOT NOTIFICATION (Wajib)
# - TELEGRAM_TOKEN: Dapatkan token dari @BotFather di Telegram
# - CHAT_ID       : ID Chat / Channel / Grup (misal: -1004492064878 atau ID pribadi)
# ------------------------------------------------------------------------------
TELEGRAM_TOKEN="masukkan_bot_token_dari_botfather"
CHAT_ID="masukkan_chat_id_tujuan"

# ------------------------------------------------------------------------------
# 4. DAFTAR URL GRUP FACEBOOK TARGET (Wajib)
# Masukkan link grup Facebook target, pisahkan dengan tanda koma (,)
# ------------------------------------------------------------------------------
FACEBOOK_GROUPS="https://facebook.com/groups/id_grup_1/,https://facebook.com/groups/id_grup_2/"

# ------------------------------------------------------------------------------
# 5. KATA KUNCI PROPERTI & URGENSI (Opsional / Override)
# Jika tidak diisi, bot akan otomatis menggunakan daftar kata kunci default.
# ------------------------------------------------------------------------------
# PROPERTY_KEYWORDS="dijual,jual,rumah,ruko,tanah,kavling,kost,gudang,apartemen,over kredit"
# URGENCY_KEYWORDS="bu,butuh uang,lelang,murah,miring,under market,turun harga,cepat,butuh dana"

# ------------------------------------------------------------------------------
# 6. PENGATURAN PROXY (Opsional - Hanya jika ingin menggunakan proxy)
# ------------------------------------------------------------------------------
USE_PROXY=false
# PROXY_SERVER="http://username:password@ip_proxy:port"

